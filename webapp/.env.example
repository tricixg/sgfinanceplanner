# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — Settings → API → service_role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: require this header on PUT /api/state (x-dashboard-secret)
# DASHBOARD_SECRET=your-random-secret

# App branding (optional)
NEXT_PUBLIC_APP_TITLE=Financial Dashboard
NEXT_PUBLIC_APP_KICKER=Personal Finance · Singapore
NEXT_PUBLIC_APP_SUBTITLE=Job transition, debt paydown & CPF outlook
NEXT_PUBLIC_APP_ASOF=All figures SGD
