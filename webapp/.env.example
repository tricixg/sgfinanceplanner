# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — optional (admin scripts only; app uses anon key + user session + RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for magic-link redirects (production)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Local dev only — skip login (never set on Vercel production)
# AUTH_BYPASS_DEV=true
# NEXT_PUBLIC_AUTH_BYPASS_DEV=true
# DEV_USER_ID=your-supabase-auth-user-uuid
# DEV_USER_EMAIL=you@example.com

# Telegram bot (server-only — see documentation/09-telegram-bot-setup.md)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# App branding (optional)
NEXT_PUBLIC_APP_TITLE=Financial Dashboard
NEXT_PUBLIC_APP_KICKER=SEE · GOH Finance
NEXT_PUBLIC_APP_SUBTITLE=Expense Tracking, debt paydown & CPF outlook
NEXT_PUBLIC_APP_ASOF=All figures SGD
